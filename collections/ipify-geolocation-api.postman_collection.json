      "name": "Geolocation",
      "description": {
        "content": "Resolve an IP, domain, or email to a country, region, city, and ISP.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "278c2a01-eb5b-493f-99c4-7a2052eba17c",
          "name": "ipify Get Country-Level Geolocation",
          "request": {
            "name": "ipify Get Country-Level Geolocation",
            "description": {
              "content": "Look up an IP, domain, or email and return its country-level geolocation and ISP. Costs 1 credit per successful request.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "country"
              ],
              "host": [
                "{{country-Url}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "apiKey",
                  "value": "<string>",
                  "description": "(Required) Personal API key for the ipify Geolocation product."
                },
                {
                  "disabled": false,
                  "key": "ipAddress",
                  "value": "<string>",
                  "description": "IPv4 or IPv6 address to look up. Defaults to the requester's IP when omitted and no `domain`/`email` is supplied."
                },
                {
                  "disabled": false,
                  "key": "domain",
                  "value": "<hostname>",
                  "description": "Domain name whose A/AAAA record should be resolved and looked up."
                },
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<email>",
                  "description": "Email address whose MX server IP should be looked up."
                },
                {
                  "disabled": false,
                  "key": "reverseIp",
                  "value": "0",
                  "description": "When `1`, include up to five reverse-DNS associated domains in the response."
                },
                {
                  "disabled": false,
                  "key": "escapedUnicode",
                  "value": "0",
                  "description": "When `1`, leave Unicode characters in escaped form rather than decoding them."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "apiKey"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "query"
                }
              ]
            }
          },
